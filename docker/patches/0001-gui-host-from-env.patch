+    // Resolver o endereço: aceita nomes de serviço do compose, não só IPs
+    {
+        struct addrinfo hints = {0}, *res = NULL;
+        const char *host = getenv("FYDELIS_HOST");
+        if (host == NULL || *host == '\0')
+            host = SERVER_IP;
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        if (getaddrinfo(host, NULL, &hints, &res) != 0 || res == NULL) {
+            g_print("Endereço inválido: %s\n", host);
+            close(sock);
+            return;
+        }
+        serv_addr.sin_addr = ((struct sockaddr_in *) res->ai_addr)->sin_addr;
+        freeaddrinfo(res);
+    }
