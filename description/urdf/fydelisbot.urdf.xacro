<?xml version="1.0"?>
<robot name="fydelisbot_humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Propriedades ===================== -->
  <xacro:property name="torso_x" value="0.30"/>
  <xacro:property name="torso_y" value="0.40"/>
  <xacro:property name="torso_z" value="0.60"/>
  <xacro:property name="torso_size" value="${torso_x} ${torso_y} ${torso_z}"/>
  <xacro:property name="torso_mass" value="20.0"/>
  <xacro:property name="head_size" value="0.25"/>
  <xacro:property name="head_mass" value="3.0"/>
  <xacro:property name="leg_len" value="0.40"/>
  <xacro:property name="leg_r" value="0.08"/>
  <xacro:property name="leg_mass" value="5.0"/>
  <xacro:property name="arm_len" value="0.30"/>
  <xacro:property name="arm_r" value="0.05"/>
  <xacro:property name="arm_mass" value="2.0"/>
  <xacro:property name="shoulder_y" value="0.22"/>
  <xacro:property name="hip_y" value="0.12"/>
  <xacro:property name="base_torso_z" value="0.70"/>
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- ===================== Inércias ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${m*(3.0*r*r+l*l)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3.0*r*r+l*l)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Materiais ===================== -->
  <material name="blue">      <color rgba="0.00 0.40 0.80 1.0"/></material>
  <material name="dark_gray"> <color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="light_gray"><color rgba="0.80 0.80 0.80 1.0"/></material>
  <material name="metallic">  <color rgba="0.70 0.70 0.70 1.0"/></material>

  <!-- ===================== Cadeia Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_torso_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_torso_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Torso ===================== -->
  <link name="torso_link">
    <xacro:box_inertia m="${torso_mass}" x="${torso_x}" y="${torso_y}" z="${torso_z}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${torso_size}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${torso_size}"/></geometry>
    </collision>
  </link>

  <!-- ===================== Cabeça ===================== -->
  <link name="head_link">
    <xacro:box_inertia m="${head_mass}" x="${head_size}" y="${head_size}" z="${head_size}"/>
    <visual>
      <origin xyz="0 0 ${head_size/2}" rpy="0 0 0"/>
      <geometry><box size="${head_size} ${head_size} ${head_size}"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${head_size/2}" rpy="0 0 0"/>
      <geometry><box size="${head_size} ${head_size} ${head_size}"/></geometry>
    </collision>
  </link>

  <joint name="neck_joint" type="revolute">
    <parent link="torso_link"/>
    <child  link="head_link"/>
    <origin xyz="0 0 ${torso_z/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <!-- ===================== Membro Genérico ===================== -->
  <xacro:macro name="limb" params="prefix side y_off joint_z axis length radius mass material effort velocity lower upper">
    <link name="${prefix}_link">
      <xacro:cyl_inertia m="${mass}" r="${radius}" l="${length}"/>
      <visual>
        <origin xyz="0 0 ${-length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}_joint" type="revolute">
      <parent link="torso_link"/>
      <child  link="${prefix}_link"/>
      <origin xyz="0 ${y_off} ${joint_z}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="0.4" friction="0.08"/>
    </joint>
  </xacro:macro>

  <!-- ===================== Braços ===================== -->
  <xacro:limb prefix="left_shoulder"  side="left"  y_off="${+shoulder_y}" joint_z="0.20"
              axis="0 1 0" length="${arm_len}" radius="${arm_r}" mass="${arm_mass}"
              material="metallic" effort="20.0" velocity="2.0" lower="-3.14" upper="3.14"/>
  <xacro:limb prefix="right_shoulder" side="right" y_off="${-shoulder_y}" joint_z="0.20"
              axis="0 1 0" length="${arm_len}" radius="${arm_r}" mass="${arm_mass}"
              material="metallic" effort="20.0" velocity="2.0" lower="-3.14" upper="3.14"/>

  <!-- ===================== Pernas ===================== -->
  <xacro:limb prefix="left_hip"  side="left"  y_off="${+hip_y}" joint_z="${-torso_z/2}"
              axis="1 0 0" length="${leg_len}" radius="${leg_r}" mass="${leg_mass}"
              material="dark_gray" effort="50.0" velocity="2.0" lower="-1.57" upper="1.57"/>
  <xacro:limb prefix="right_hip" side="right" y_off="${-hip_y}" joint_z="${-torso_z/2}"
              axis="1 0 0" length="${leg_len}" radius="${leg_r}" mass="${leg_mass}"
              material="dark_gray" effort="50.0" velocity="2.0" lower="-1.57" upper="1.57"/>

  <!-- ===================== Gazebo ===================== -->
  <xacro:macro name="gazebo_params" params="link mu kp kv">
    <gazebo reference="${link}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
      <kp>${kp}</kp>
      <kv>${kv}</kv>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <xacro:gazebo_params link="left_hip_link"  mu="0.9" kp="1e6" kv="1.0"/>
  <xacro:gazebo_params link="right_hip_link" mu="0.9" kp="1e6" kv="1.0"/>

</robot>

