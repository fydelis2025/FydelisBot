<?xml version="1.0"?>
<robot name="fydelisbot_humanoid_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Propriedades ===================== -->
  <xacro:property name="torso_x" value="0.25"/>
  <xacro:property name="torso_y" value="0.35"/>
  <xacro:property name="torso_z" value="0.55"/>
  <xacro:property name="torso_mass" value="15.0"/>

  <xacro:property name="head_size" value="0.20"/>
  <xacro:property name="head_mass" value="2.0"/>

  <xacro:property name="thigh_len" value="0.35"/>
  <xacro:property name="thigh_r" value="0.06"/>
  <xacro:property name="thigh_mass" value="3.5"/>

  <xacro:property name="shin_len" value="0.35"/>
  <xacro:property name="shin_r" value="0.05"/>
  <xacro:property name="shin_mass" value="2.5"/>

  <xacro:property name="upper_arm_len" value="0.25"/>
  <xacro:property name="upper_arm_r" value="0.04"/>
  <xacro:property name="upper_arm_mass" value="1.5"/>

  <xacro:property name="lower_arm_len" value="0.25"/>
  <xacro:property name="lower_arm_r" value="0.035"/>
  <xacro:property name="lower_arm_mass" value="1.2"/>

  <xacro:property name="shoulder_y" value="0.20"/>
  <xacro:property name="hip_y" value="0.10"/>
  <xacro:property name="base_torso_z" value="0.85"/>
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- ===================== Inércias ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 ${-l/2}" rpy="0 0 0"/>
      <inertia ixx="${m*(3.0*r*r+l*l)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3.0*r*r+l*l)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Materiais ===================== -->
  <material name="carbon_black"> <color rgba="0.10 0.10 0.12 1.0"/></material>
  <material name="cyber_blue">   <color rgba="0.00 0.55 0.95 1.0"/></material>
  <material name="titanium">     <color rgba="0.75 0.75 0.80 1.0"/></material>
  <material name="dark_gray">    <color rgba="0.25 0.25 0.28 1.0"/></material>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_torso_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_torso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Torso ===================== -->
  <link name="torso_link">
    <xacro:box_inertia m="${torso_mass}" x="${torso_x}" y="${torso_y}" z="${torso_z}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${torso_x} ${torso_y} ${torso_z}"/></geometry>
      <material name="cyber_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${torso_x} ${torso_y} ${torso_z}"/></geometry>
    </collision>
  </link>

  <!-- ===================== Cabeça (com Visor de Sensores) ===================== -->
  <link name="head_link">
    <xacro:box_inertia m="${head_mass}" x="${head_size}" y="${head_size}" z="${head_size}"/>
    <visual>
      <origin xyz="0 0 ${head_size/2}" rpy="0 0 0"/>
      <geometry><box size="${head_size} ${head_size} ${head_size}"/></geometry>
      <material name="carbon_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${head_size/2}" rpy="0 0 0"/>
      <geometry><box size="${head_size} ${head_size} ${head_size}"/></geometry>
    </collision>
  </link>

  <joint name="neck_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 ${torso_z/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="15.0" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- ===================== Braços Modulares ===================== -->
  <xacro:macro name="arm_chain" params="side y_sign">
    <!-- Ombro Pitch -->
    <link name="${side}_shoulder_pitch_link">
      <xacro:cyl_inertia m="${upper_arm_mass/2}" r="${upper_arm_r}" l="${upper_arm_len}"/>
      <visual>
        <origin xyz="0 0 ${-upper_arm_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${upper_arm_r}" length="${upper_arm_len}"/></geometry>
        <material name="titanium"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_arm_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${upper_arm_r}" length="${upper_arm_len}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_shoulder_pitch_joint" type="revolute">
      <parent link="torso_link"/>
      <child link="${side}_shoulder_pitch_link"/>
      <origin xyz="0 ${y_sign * shoulder_y} ${torso_z/2 - 0.05}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.5" upper="2.5" effort="30.0" velocity="3.0"/>
      <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- Cotovelo -->
    <link name="${side}_elbow_link">
      <xacro:cyl_inertia m="${lower_arm_mass}" r="${lower_arm_r}" l="${lower_arm_len}"/>
      <visual>
        <origin xyz="0 0 ${-lower_arm_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lower_arm_r}" length="${lower_arm_len}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-lower_arm_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lower_arm_r}" length="${lower_arm_len}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_elbow_joint" type="revolute">
      <parent link="${side}_shoulder_pitch_link"/>
      <child link="${side}_elbow_link"/>
      <origin xyz="0 0 ${-upper_arm_len}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.0" upper="0.0" effort="20.0" velocity="3.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:arm_chain side="left"  y_sign="1"/>
  <xacro:arm_chain side="right" y_sign="-1"/>

  <!-- ===================== Pernas Humanóides Avançadas ===================== -->
  <xacro:macro name="leg_chain" params="side y_sign">
    <!-- Coxa -->
    <link name="${side}_thigh_link">
      <xacro:cyl_inertia m="${thigh_mass}" r="${thigh_r}" l="${thigh_len}"/>
      <visual>
        <origin xyz="0 0 ${-thigh_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${thigh_r}" length="${thigh_len}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${thigh_r}" length="${thigh_len}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_hip_joint" type="revolute">
      <parent link="torso_link"/>
      <child link="${side}_thigh_link"/>
      <origin xyz="0 ${y_sign * hip_y} ${-torso_z/2}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.2" upper="0.5" effort="80.0" velocity="5.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Canela -->
    <link name="${side}_shin_link">
      <xacro:cyl_inertia m="${shin_mass}" r="${shin_r}" l="${shin_len}"/>
      <visual>
        <origin xyz="0 0 ${-shin_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${shin_r}" length="${shin_len}"/></geometry>
        <material name="titanium"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-shin_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${shin_r}" length="${shin_len}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_knee_joint" type="revolute">
      <parent link="${side}_thigh_link"/>
      <child link="${side}_shin_link"/>
      <origin xyz="0 0 ${-thigh_len}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="2.0" effort="80.0" velocity="5.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:leg_chain side="left"  y_sign="1"/>
  <xacro:leg_chain side="right" y_sign="-1"/>

  <!-- ===================== Configurações do Gazebo ===================== -->
  <gazebo reference="torso_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  
  <gazebo reference="head_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

</robot>
